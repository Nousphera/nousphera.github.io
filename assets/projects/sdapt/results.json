{
  "title": "Domain Adaptive Pretraining in Split Learning for Vision Foundation Models",
  "authors": [
    "Stan van Honk",
    "Vasileios Tsouvalas",
    "Nirvana Meratnia"
  ],
  "version": "Author manuscript compiled 13 October 2026",
