  "methodology": {
    "source": "PDF sections 2 and 3, pages 2-3; Fig. 1",
    "backbone": "DINOv2-pretrained ViT-B/14",
    "clients": 10,
    "partition": "identical IID partitions for DAPT and fine-tuning",
    "domain_scope": "three independent same-domain vision experiments",
    "split": "client keeps first transformer block frozen; server hosts remaining blocks",
    "server_training": "last transformer block fully unfrozen (last two for CheXpert); other server blocks adapted with LoRA",
    "phase1": "Clients form 2 global and 8 local crops from unlabeled in-domain images, compute frozen frontend features, and upload CLS and patch tokens. Server concatenates all client features, trains the DINOv2 student using self-supervision and updates an EMA teacher. iBOT masking is applied on the server. No gradients return to clients.",
    "phase2": "The adapted teacher backbone is frozen. Clients send features of original non-augmented labeled images, server returns CLS representation for classification, and each client trains its task-specific head locally. No task-head gradients are sent to the server.",
    "crop_pixels": {
      "fMoW": {
        "global": 224,
        "local": 98
      },
      "QuickDraw": {
        "global": 224,
        "local": 98
      },
      "CheXpert": {
        "global": 518,
        "local": 196
      }
    },
    "task_data": "DAPT uses training images without their labels; downstream fine-tuning uses only labeled subset. CheXpert training is evaluated on the CheXlocalize test set.",
    "fewshot_sampling": "Each client samples k-shot data with a client-specific seed shared across methods; numerical seeds are not given.",
    "dino_naming": "DINOv2 is the pretrained model and continued pretraining recipe. L_DINO is one term of the DINOv2 objective, alongside iBOT and KoLeo; calling the method DINO-only would omit those terms."
  },
  "equations": [
    {
      "id": "feature_split",
      "source": "section 2.1, page 2",
      "latex": "(h_{\\mathrm{cls}},\\mathbf H)=f_{\\theta_c}(x),\\qquad (z_{\\mathrm{cls}},\\mathbf Z)=f_{\\theta_s}(h_{\\mathrm{cls}},\\mathbf H)"
    },
    {
      "id": "global_batch",
      "source": "section 2.1, page 2",
      "latex": "\\mathcal B^U=\\bigcup_{n\\in\\mathcal N}\\mathcal B_n^U"
    },
    {
      "id": "ssl_loss",
      "source": "Eq. (1), page 2",
      "latex": "\\mathcal L_{\\mathrm{SSL}}=\\mathcal L_{\\mathrm{DINO}}+\\lambda_1\\mathcal L_{\\mathrm{iBOT}}+\\lambda_2\\mathcal L_{\\mathrm{KoLeo}}"
    },
    {
      "id": "task_loss",
      "source": "Eq. (2), page 3",
      "latex": "\\mathcal L_{\\mathrm{FT}}^{(n)}=\\mathcal L_{\\mathrm{sup}}\\!\\left(g_{\\phi_n}(r_n(x)),y\\right)"
    }
  ],
